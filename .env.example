# Supabase — get these from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER prefix with NEXT_PUBLIC_. Used for admin/rate-limit ops.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_PROJECT_ID=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 — optional. Leave unset to disable GA entirely (local
# dev, PR previews, etc.); no gtag.js script loads and no events fire.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Captcha (Cloudflare Turnstile recommended — free, no phone verification)
# Not required when NODE_ENV=development — Turnstile is fully bypassed locally.
# Required in production; sendMessageAction fails closed if unset there.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Rate limiting (Upstash Redis — free tier works for thousands of users)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Random long string, used to salt the one-way sender fingerprint hash
FINGERPRINT_SALT=

# Firebase Admin SDK — server-only, used by src/lib/firebase-admin.ts to
# send push notifications (see /api/push/test and src/lib/push-notifications.ts).
# From your Firebase service account JSON (Project Settings > Service
# accounts > Generate new private key). NEVER prefix with NEXT_PUBLIC_.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

